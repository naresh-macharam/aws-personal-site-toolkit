# Generated by Terraform — copy this into site/hugo.yaml
# (Re-running `terraform apply` after changing tfvars will regenerate this
# file automatically, so you rarely need to hand-edit it.)
baseURL: "https://${domain_name}/blog/"
languageCode: "en-us"
title: "${site_title}"

params:
  description: "${site_description}"
  homeURL: "https://${domain_name}/"
  logoText: "${logo_text}"

  homeNavLinks:
    - label: "About"
      url: "https://${domain_name}/#about"
    - label: "Work"
      url: "https://${domain_name}/#work"

  blogHeadline: "${blog_headline}"
  blogSubhead: "${blog_subhead}"

  commentEndpoint: "${comment_endpoint}"

  colors:
    bg: "${color_bg}"
    surface: "${color_surface}"
    surface2: "${color_surface2}"
    border: "${color_border}"
    borderSoft: "${color_border_soft}"
    ink: "${color_ink}"
    inkDim: "${color_ink_dim}"
    inkFaint: "${color_ink_faint}"
    accent: "${color_accent}"
    accentDim: "${color_accent_dim}"
